/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Blair ATP";
	compatible = "qcom,blair-atp\0qcom,blair\0qcom,atp";
	qcom,msm-id = <0x1fb 0x10000>;
	qcom,board-id = <0x21 0x00>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,num-macros = <0x03>;
			qcom,bolero-version = <0x05>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			bolero-clk-rsc-mngr {
				compatible = "qcom,bolero-clk-rsc-mngr";
				qcom,fs-gen-sequence = <0x3000 0x01 0x01 0x3004 0x03 0x03 0x3004 0x03 0x01 0x3080 0x02 0x02>;
				qcom,rx_mclk_mode_muxsel = <0xa5640d8>;
				qcom,va_mclk_mode_muxsel = "\nz\0";
				clock-names = "tx_core_clk\0tx_npl_clk\0rx_core_clk\0rx_npl_clk\0va_core_clk\0va_npl_clk";
				clocks = <0x01 0x00 0x02 0x00 0x03 0x00 0x04 0x00 0x05 0x00 0x06 0x00>;
			};

			va-macro@A730000 {
				compatible = "qcom,va-macro";
				reg = <0xa730000 0x00>;
				clock-names = "lpass_audio_hw_vote";
				clocks = <0xffffffff 0x00>;
				qcom,va-dmic-sample-rate = <0x927c0>;
				qcom,default-clk-id = <0x00>;
				qcom,is-used-swr-gpio = <0x01>;
				qcom,va-swr-gpios = <0xffffffff>;
				phandle = <0x5e>;

				va_swr_master {
					compatible = "qcom,swr-mstr";
					qcom,is_wcd937x = <0x01>;
					#address-cells = <0x02>;
					#size-cells = <0x00>;
					clock-names = "lpass_audio_hw_vote";
					clocks = <0xffffffff 0x00>;
					qcom,swr_master_id = <0x03>;
					qcom,swrm-hctl-reg = <0xa7ec100>;
					qcom,mipi-sdw-block-packing-mode = <0x01>;
					swrm-io-base = <0xa740000 0x00>;
					interrupts-extended = <0xffffffff 0x05 0x04 0xffffffff 0x80 0x00>;
					interrupt-names = "swr_master_irq\0swr_wake_irq";
					qcom,swr-num-ports = <0x03>;
					qcom,swr-port-mapping = <0x01 0x22 0x01 0x01 0x23 0x02 0x01 0x24 0x04 0x01 0x25 0x08 0x02 0x26 0x01 0x02 0x27 0x02 0x02 0x28 0x04 0x02 0x29 0x08 0x03 0x2a 0x01 0x03 0x2b 0x02 0x03 0x2c 0x04 0x03 0x2d 0x08>;
					qcom,swr-num-dev = <0x01>;
					qcom,swr-phy-dev-addr = <0x0a 0x1170223 0x08 0x58350223 0x08 0x58350222 0x08 0x58350221 0x08 0x58350220>;
					qcom,swr-clock-stop-mode0 = <0x01>;
					qcom,swr-mstr-irq-wakeup-capable = <0x01>;
					qcom,is-always-on = <0x01>;
					phandle = <0x5f>;

					wcd937x-tx-slave {
						compatible = "qcom,wcd937x-slave";
						reg = <0x0a 0x1170223>;
						status = "disabled";
						phandle = <0x0e>;
					};

					wcd938x-tx-slave {
						status = "disabled";
						compatible = "qcom,wcd938x-slave";
						reg = <0x0d 0x1170223>;
						phandle = <0x09>;
					};
				};
			};

			tx-macro@A620000 {
				compatible = "qcom,tx-macro";
				reg = <0xa620000 0x00>;
				clock-names = "tx_core_clk\0tx_npl_clk";
				clocks = <0x01 0x00 0x02 0x00>;
				qcom,tx-dmic-sample-rate = <0x249f00>;
				qcom,is-used-swr-gpio = <0x00>;
				phandle = <0x60>;
			};

			rx-macro@A600000 {
				compatible = "qcom,rx-macro";
				reg = <0xa600000 0x00>;
				clock-names = "rx_core_clk\0rx_npl_clk";
				clocks = <0x03 0x00 0x04 0x00>;
				qcom,rx-swr-gpios = <0xffffffff>;
				qcom,rx_mclk_mode_muxsel = <0xa5640d8>;
				qcom,rx-bcl-pmic-params = [00 03 48];
				qcom,default-clk-id = <0x00>;
				phandle = <0x61>;

				rx_swr_master {
					compatible = "qcom,swr-mstr";
					#address-cells = <0x02>;
					#size-cells = <0x00>;
					clock-names = "lpass_audio_hw_vote";
					clocks = <0xffffffff 0x00>;
					qcom,swr_master_id = <0x02>;
					qcom,swrm-hctl-reg = <0xa6a9098>;
					qcom,mipi-sdw-block-packing-mode = <0x01>;
					swrm-io-base = <0xa610000 0x00>;
					interrupts = <0x00 0x129 0x04>;
					interrupt-names = "swr_master_irq";
					qcom,swr-num-ports = <0x06>;
					qcom,swr-port-mapping = <0x01 0x09 0x01 0x01 0x0a 0x02 0x02 0x0d 0x01 0x03 0x0b 0x01 0x03 0x0c 0x02 0x04 0x0e 0x01 0x05 0x0f 0x01 0x05 0x10 0x02 0x06 0x21 0x01>;
					qcom,swr-num-dev = <0x01>;
					qcom,swr-clock-stop-mode0 = <0x01>;
					phandle = <0x62>;

					wcd937x-rx-slave {
						compatible = "qcom,wcd937x-slave";
						reg = <0x0a 0x1170224>;
						status = "disabled";
						phandle = <0x0d>;
					};

					wcd938x-rx-slave {
						status = "disabled";
						compatible = "qcom,wcd938x-slave";
						reg = <0x0d 0x1170224>;
						phandle = <0x08>;
					};
				};
			};

			wcd938x-codec {
				status = "disabled";
				compatible = "qcom,wcd938x-codec";
				qcom,split-codec = <0x01>;
				qcom,rx_swr_ch_map = <0x00 0x09 0x01 0x00 0x09 0x00 0x0a 0x02 0x00 0x0a 0x01 0x0d 0x01 0x00 0x0d 0x02 0x0b 0x01 0x00 0x0b 0x02 0x0c 0x02 0x00 0x0c 0x03 0x0e 0x01 0x00 0x0e 0x04 0x0f 0x01 0x00 0x0f 0x04 0x10 0x02 0x00 0x10>;
				qcom,tx_swr_ch_map = <0x00 0x12 0x01 0x00 0x22 0x00 0x13 0x02 0x00 0x23 0x01 0x14 0x01 0x00 0x24 0x01 0x15 0x02 0x00 0x25 0x02 0x16 0x01 0x00 0x26 0x02 0x17 0x02 0x00 0x27 0x02 0x11 0x04 0x00 0x28 0x02 0x18 0x04 0x00 0x28 0x02 0x19 0x08 0x00 0x29 0x03 0x1a 0x01 0x00 0x2a 0x03 0x1b 0x02 0x00 0x2b 0x03 0x1c 0x04 0x00 0x2c 0x03 0x1d 0x08 0x00 0x2d>;
				qcom,wcd-rst-gpio-node = <0x07>;
				qcom,rx-slave = <0x08>;
				qcom,tx-slave = <0x09>;
				cdc-vdd-rxtx-supply = <0x0a>;
				qcom,cdc-vdd-rxtx-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vdd-rxtx-current = <0x7530>;
				cdc-vddio-supply = <0x0a>;
				qcom,cdc-vddio-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vddio-current = <0x7530>;
				cdc-vdd-buck-supply = <0x0b>;
				qcom,cdc-vdd-buck-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vdd-buck-current = <0x9eb10>;
				cdc-vdd-mic-bias-supply = <0x0c>;
				qcom,cdc-vdd-mic-bias-voltage = "\02K\0\02K";
				qcom,cdc-vdd-mic-bias-current = <0x7530>;
				qcom,cdc-micbias1-mv = <0x708>;
				qcom,cdc-micbias2-mv = <0x708>;
				qcom,cdc-micbias3-mv = <0x708>;
				qcom,cdc-micbias4-mv = <0x708>;
				qcom,cdc-static-supplies = "cdc-vdd-rxtx\0cdc-vddio\0cdc-vdd-mic-bias";
				qcom,cdc-on-demand-supplies = "cdc-vdd-buck";
				phandle = <0x63>;
			};

			wcd937x-codec {
				compatible = "qcom,wcd937x-codec";
				qcom,split-codec = <0x01>;
				qcom,rx_swr_ch_map = <0x00 0x09 0x01 0x00 0x09 0x00 0x0a 0x02 0x00 0x0a 0x01 0x0d 0x01 0x00 0x0d 0x02 0x0b 0x01 0x00 0x0b 0x02 0x0c 0x02 0x00 0x0c 0x03 0x0e 0x01 0x00 0x0e 0x04 0x0f 0x01 0x00 0x0f 0x04 0x10 0x02 0x00 0x10>;
				qcom,tx_swr_ch_map = <0x00 0x12 0x01 0x00 0x22 0x01 0x13 0x01 0x00 0x26 0x01 0x14 0x02 0x00 0x27 0x02 0x16 0x01 0x00 0x25 0x02 0x17 0x02 0x00 0x26 0x02 0x11 0x04 0x00 0x27 0x03 0x18 0x01 0x00 0x28 0x03 0x19 0x02 0x00 0x29 0x03 0x1a 0x04 0x00 0x2a 0x03 0x1b 0x08 0x00 0x2b>;
				qcom,wcd-rst-gpio-node = <0x07>;
				qcom,rx-slave = <0x0d>;
				qcom,tx-slave = <0x0e>;
				cdc-vdd-rxtx-supply = <0x0a>;
				qcom,cdc-vdd-rxtx-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vdd-rxtx-current = <0x7530>;
				cdc-vddpx-supply = <0x0a>;
				qcom,cdc-vddpx-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vddpx-current = <0x7530>;
				cdc-vdd-buck-supply = <0x0b>;
				qcom,cdc-vdd-buck-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vdd-buck-current = <0x9eb10>;
				cdc-vdd-mic-bias-supply = <0x0c>;
				qcom,cdc-vdd-mic-bias-voltage = "\02K\0\02K";
				qcom,cdc-vdd-mic-bias-current = <0xafc8>;
				qcom,cdc-micbias1-mv = <0x708>;
				qcom,cdc-micbias2-mv = <0x708>;
				qcom,cdc-micbias3-mv = <0x708>;
				qcom,cdc-static-supplies = "cdc-vdd-rxtx\0cdc-vddpx\0cdc-vdd-mic-bias";
				qcom,cdc-on-demand-supplies = "cdc-vdd-buck";
				status = "disabled";
				phandle = <0x0f>;
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,model = "holi-mtp-snd-card";
			qcom,sku-model = "holi-mtpsku1-snd-card";
			qcom,msm-mi2s-master = <0x01 0x01 0x01 0x01>;
			qcom,wcn-btfm = <0x01>;
			qcom,tdm-max-slots = <0x04>;
			qcom,audio-routing = "AMIC1\0Analog Mic1\0Analog Mic1\0MIC BIAS1\0AMIC2\0Analog Mic2\0Analog Mic2\0MIC BIAS2\0AMIC3\0Analog Mic3\0Analog Mic3\0MIC BIAS3\0TX DMIC0\0Digital Mic0\0TX DMIC0\0MIC BIAS1\0TX DMIC1\0Digital Mic1\0TX DMIC1\0MIC BIAS1\0TX DMIC2\0Digital Mic2\0TX DMIC2\0MIC BIAS3\0TX DMIC3\0Digital Mic3\0TX DMIC3\0MIC BIAS3\0IN1_HPHL\0HPHL_OUT\0IN2_HPHR\0HPHR_OUT\0IN3_AUX\0AUX_OUT\0RX_TX DEC0_INP\0TX DEC0 MUX\0RX_TX DEC1_INP\0TX DEC1 MUX\0RX_TX DEC2_INP\0TX DEC2 MUX\0RX_TX DEC3_INP\0TX DEC3 MUX\0TX SWR_INPUT\0WCD_TX_OUTPUT\0VA SWR_INPUT\0VA_SWR_CLK\0VA SWR_INPUT\0WCD_TX_OUTPUT\0VA_AIF1 CAP\0VA_SWR_CLK\0VA_AIF2 CAP\0VA_SWR_CLK\0VA_AIF3 CAP\0VA_SWR_CLK\0VA DMIC0\0Digital Mic0\0VA DMIC1\0Digital Mic1\0VA DMIC2\0Digital Mic2\0VA DMIC3\0Digital Mic3\0VA DMIC4\0Digital Mic4\0VA DMIC5\0Digital Mic5\0VA DMIC0\0VA MIC BIAS1\0VA DMIC1\0VA MIC BIAS1\0VA DMIC2\0VA MIC BIAS3\0VA DMIC3\0VA MIC BIAS3";
			qcom,msm-mbhc-hphl-swh = <0x01>;
			qcom,msm-mbhc-gnd-swh = <0x01>;
			qcom,cdc-dmic01-gpios = <0xffffffff>;
			qcom,cdc-dmic23-gpios = <0xffffffff>;
			nvmem-cells = <0xffffffff>;
			nvmem-cell-names = "adsp_variant";
			asoc-codec = <0xffffffff 0xffffffff 0x0f>;
			asoc-codec-names = "msm-stub-codec.1\0bolero_codec\0wcd937x_codec";
			qcom,msm_audio_ssr_devs = <0xffffffff 0xffffffff 0xffffffff 0xffffffff>;
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			wsa881x-i2c-codec@e {
				status = "disabled";
				compatible = "qcom,wsa881x-i2c-codec";
				reg = <0x0e>;
				clock-names = "wsa_mclk";
				clocks = <0x10 0x00>;
				qcom,wsa-analog-clk-gpio = <0xffffffff>;
				qcom,wsa-analog-reset-gpio = <0x11>;
				cdc-vdd-1p8-supply = <0x0a>;
				qcom,cdc-vdd-1p8-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vdd-1p8-current = <0x2710>;
				qcom,cdc-static-supplies = "cdc-vdd-1p8";
				qcom,wsa-prefix = "SpkrMono";
				phandle = <0x64>;
			};

			wsa881x-i2c-codec@44 {
				status = "disabled";
				compatible = "qcom,wsa881x-i2c-codec";
				reg = <0x44>;
				qcom,wsa-analog-clk-gpio = <0xffffffff>;
				phandle = <0x65>;
			};

			wsa881x-i2c-codec@f {
				status = "disabled";
				compatible = "qcom,wsa881x-i2c-codec";
				reg = <0x0f>;
				clock-names = "wsa_mclk";
				clocks = <0x10 0x00>;
				qcom,wsa-analog-clk-gpio = <0xffffffff>;
				qcom,wsa-analog-reset-gpio = <0x11>;
				cdc-vdd-1p8-supply = <0x0a>;
				qcom,cdc-vdd-1p8-voltage = <0x1b7740 0x1b7740>;
				qcom,cdc-vdd-1p8-current = <0x2710>;
				qcom,cdc-static-supplies = "cdc-vdd-1p8";
				qcom,wsa-prefix = "SpkrMono";
				phandle = <0x66>;
			};

			wsa881x-i2c-codec@45 {
				status = "disabled";
				compatible = "qcom,wsa881x-i2c-codec";
				reg = <0x45>;
				qcom,wsa-analog-clk-gpio = <0xffffffff>;
				phandle = <0x67>;
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,msm-dai-is-island-supported = <0x01>;
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			msm_cdc_pinctrl@32 {
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active\0aud_sleep";
				pinctrl-0 = <0xffffffff>;
				pinctrl-1 = <0xffffffff>;
				phandle = <0x07>;
			};

			wsa_reset_gpio {
				status = "disabled";
				compatible = "qcom,msm-cdc-pinctrl";
				pinctrl-names = "aud_active\0aud_sleep";
				pinctrl-0 = <0xffffffff>;
				pinctrl-1 = <0xffffffff>;
				#gpio-cells = <0x00>;
				phandle = <0x11>;
			};

			wsa_ana_clk {
				status = "disabled";
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x03>;
				qcom,codec-lpass-ext-clk-freq = <0x927c00>;
				qcom,codec-lpass-clk-id = <0x301>;
				#clock-cells = <0x01>;
				phandle = <0x10>;
			};

			rx_core_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x05>;
				qcom,codec-lpass-ext-clk-freq = <0x1588800>;
				qcom,codec-lpass-clk-id = <0x30e>;
				#clock-cells = <0x01>;
				phandle = <0x03>;
			};

			rx_npl_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x06>;
				qcom,codec-lpass-ext-clk-freq = <0x1588800>;
				qcom,codec-lpass-clk-id = <0x30f>;
				#clock-cells = <0x01>;
				phandle = <0x04>;
			};

			tx_core_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x07>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x30c>;
				#clock-cells = <0x01>;
				phandle = <0x01>;
			};

			tx_npl_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x08>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x30d>;
				#clock-cells = <0x01>;
				phandle = <0x02>;
			};

			va_core_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x02>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x30b>;
				#clock-cells = <0x01>;
				phandle = <0x05>;
			};

			va_npl_clk {
				compatible = "qcom,audio-ref-clk";
				qcom,codec-ext-clk-src = <0x0a>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-lpass-clk-id = <0x310>;
				#clock-cells = <0x01>;
				phandle = <0x06>;
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
			nvmem-cells = <0xffffffff>;
			nvmem-cell-names = "adsp_variant";
			adsp-fw-names = "adsp2";
			adsp-fw-bit-values = <0x01>;
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm6350@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100>;
					phandle = <0x68>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800>;
					interrupts = <0x00 0x08 0x00 0x03 0x00 0x08 0x01 0x03>;
					interrupt-names = "kpdpwr\0resin";
					qcom,pon-dbc-delay = <0x3d09>;
					qcom,kpdpwr-sw-debounce;
					qcom,system-reset;
					qcom,store-hard-reset-reason;

					qcom,pon_1 {
						qcom,pon-type = <0x00>;
						qcom,pull-up;
						linux,code = <0x74>;
					};

					qcom,pon_2 {
						qcom,pon-type = <0x01>;
						qcom,pull-up;
						linux,code = <0x72>;
					};
				};

				qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x00 0x24 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x12>;
				};

				clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x01>;
					clock-output-names = "pm6350_div_clk1";
					clocks = <0xffffffff 0x00>;
					clock-names = "xo";
					status = "disabled";
					phandle = <0x69>;
				};

				pinctrl@c000 {
					compatible = "qcom,pm6350-gpio";
					reg = <0xc000>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x50>;

					key_vol_up {

						key_vol_up_default {
							pins = "gpio2";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x00>;
							phandle = <0x4f>;
						};
					};
				};
			};

			qcom,pm6350@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				qcom,pwms@6000 {
					status = "disabled";
					compatible = "qcom,pwm-lpg";
					reg = <0x6000>;
					reg-names = "lpg-base";
					qcom,num-lpg-channels = <0x01>;
					#pwm-cells = <0x02>;
					phandle = <0x6a>;
				};
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {

			pm6350_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
