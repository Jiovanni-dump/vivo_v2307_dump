on boot
    mkdir /dev/socket/qcrild 0750 radio radio

service vendor.qcrild /vendor/bin/hw/qcrilNrd
    class main
    user radio
    disabled
    group radio cache inet misc audio log readproc wakelock oem_2901
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW

service vendor.qcrild2 /vendor/bin/hw/qcrilNrd -c 2
    class main
    user radio
    disabled
    group radio cache inet misc audio log readproc wakelock oem_2901
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW

service vendor.qcrild3 /vendor/bin/hw/qcrilNrd -c 3
    class main
    user radio
    disabled
    group radio cache inet misc audio log readproc wakelock oem_2901
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW

# vivo liuming add for SIM_CONFIG begin
service vendor.qcrild.gms /vendor/bin/hw/qcrilNrd -gms
    class late_start
    user root
    group system radio
    oneshot
# vivo liuming add for SIM_CONFIG end
