<?xml version="1.0" encoding="utf-8"?>
<ntc_auto_test>
	<iteminfo name = "BOARD_THERM" operation="read"  path="/sys/class/cms_class/primary_board_temp" value_deal="/10" value_type="%.1f"/>
	<iteminfo name = "5G_PA_THERM" operation="read"  basic_path="/sys/class/thermal/thermal_zone%d"  if_type = "5g-pa-therm-usr"  value_deal="/1000"	value_type="%.1f" repeat-times="6"/>
	<iteminfo name = "BATT_THERM" operation="read"  path="/sys/class/cms_class/temp_raw" value_deal="/10" value_type="%.1f"/>
	<iteminfo name = "TBAT" operation="read"  path="/sys/class/power_supply/battery/temp" value_deal="/10" value_type="%.1f"/>
	<iteminfo name = "4G_PA_THERM" operation="read" basic_path="/sys/class/thermal/thermal_zone%d"  if_type = "ltepa_ntc"  value_deal="/1000"	value_type="%.1f" />
	<Command name = "AT+BK_PWR_NTC=1,1">
		<item name = "BOARD_THERM"/>
		<item name = "BATT_THERM"/>
	</Command>
	<Command name = "AT+BK_PWR_NTC=1,2" cache_file="/cache/recovery/last_ntc_temperature">
		<item name = "TBAT"/>
		<item name = "USB_CON_THERM"/>
		<item name = "4G_PA_THERM"/>
		<item name = "5G_PA_THERM"/>
        
	</Command>
</ntc_auto_test>